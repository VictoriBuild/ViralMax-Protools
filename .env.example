# --- Supabase (web gateway) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini API (cloud transcription, server-side only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Cloud sifter credit pricing (server-side only) ---
SIFTER_CREDIT_COST=3
LOW_CREDIT_THRESHOLD=10

# --- Paystack (billing, server-side only) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- Resend (transactional email, server-side only) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=MediaSuite <noreply@example.com>

# --- PostHog (telemetry) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=

# --- Cloudflare R2 (artifact storage, server-side only) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Web gateway origin (desktop app) ---
NEXT_PUBLIC_WEB_URL=http://localhost:3000
